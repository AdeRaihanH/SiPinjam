{
  "expo": {
    "name": "SiPinjam",
    "slug": "sipinjam",
    "version": "1.0.0",
    "description": "Aplikasi peminjaman alat laboratorium dengan katalog, QR Code, pengingat jatuh tempo, dan pencatatan denda.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sipinjam",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aderaihan.sipinjam",
      "infoPlist": {
        "NSCameraUsageDescription": "SiPinjam memerlukan kamera untuk memindai QR code alat dan pinjaman."
      }
    },
    "android": {
      "package": "com.aderaihan.sipinjam",
      "adaptiveIcon": {
        "backgroundColor": "#1B2559",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "SiPinjam",
      "shortName": "SiPinjam",
      "lang": "id",
      "themeColor": "#1B2559",
      "backgroundColor": "#F5F7FB",
      "description": "Katalog alat laboratorium, peminjaman, pemindaian QR, pengingat jatuh tempo, dan pencatatan denda.",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "SiPinjam memerlukan kamera untuk memindai QR code alat dan pinjaman.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1B2559"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b1bab2c0-c58d-4b6a-b894-83f146720b0c"
      }
    },
    "owner": "aderaihanhanafi"
  }
}
