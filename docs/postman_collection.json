{
  "info": {
    "_postman_id": "a7c2e4d1-2f2f-4f57-9e45-8d1c7b6a5e31",
    "name": "SiPinjam API (Supabase)",
    "description": "Koleksi pengujian REST API SiPinjam. Jalankan Login lebih dulu agar token terisi, lalu Create Loan sebelum endpoint yang memakai {{loanId}} atau {{loanKode}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "rootUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "toolId", "value": "b0000010-0000-4000-8000-000000000010" },
    { "key": "loanId", "value": "" },
    { "key": "loanKode", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "tanggalKembali", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{rootUrl}}/health",
        "description": "Health check + koneksi Supabase."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login demo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  pm.collectionVariables.set('memberId', json.data.member.id);",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"2112012414011\",\n  \"password\": \"praktikum123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Profil saya",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Kategori",
      "item": [
        {
          "name": "Daftar kategori",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/categories"
          }
        }
      ]
    },
    {
      "name": "Alat",
      "item": [
        {
          "name": "Katalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tools?limit=20"
          }
        },
        {
          "name": "Cari osiloskop",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tools?search=osilo"
          }
        },
        {
          "name": "Filter kategori",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tools?category_id=33333333-3333-4333-8333-333333333333"
          }
        },
        {
          "name": "Detail alat",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tools/{{toolId}}"
          }
        },
        {
          "name": "Cari alat dari QR",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/tools/kode/SIPINJAM%3ATOOL%3AALK-002"
          }
        }
      ]
    },
    {
      "name": "Pinjaman",
      "item": [
        {
          "name": "Buat pinjaman",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 86400000);",
                  "pm.collectionVariables.set('tanggalKembali', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('loanId', json.data.id);",
                  "  pm.collectionVariables.set('loanKode', json.data.kode);",
                  "}",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tanggal_kembali_rencana\": \"{{tanggalKembali}}\",\n  \"catatan\": \"Uji dari Postman\",\n  \"items\": [\n    { \"tool_id\": \"{{toolId}}\", \"jumlah\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/loans",
            "description": "Akun demo tidak memiliki pinjaman terlambat. Jika alat sudah aktif, ganti toolId atau kembalikan pinjaman terlebih dahulu."
          }
        },
        {
          "name": "Daftar aktif",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loans?status=aktif"
          }
        },
        {
          "name": "Daftar selesai",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loans?status=selesai"
          }
        },
        {
          "name": "Daftar semua",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loans?status=semua"
          }
        },
        {
          "name": "Detail pinjaman",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loans/{{loanId}}"
          }
        },
        {
          "name": "Cari pinjaman dari QR",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/loans/kode/SIPINJAM%3ALOAN%3A{{loanKode}}"
          }
        },
        {
          "name": "Kembalikan alat",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/loans/{{loanId}}/return",
            "description": "Denda dihitung dari tanggal. Pengembalian kedua menghasilkan 409 CONFLICT."
          }
        }
      ]
    },
    {
      "name": "Notifikasi",
      "item": [
        {
          "name": "Daftar notifikasi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.length) pm.collectionVariables.set('notificationId', json.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/notifications?limit=20"
          }
        },
        {
          "name": "Tandai satu dibaca",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
          }
        },
        {
          "name": "Tandai semua dibaca",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Statistik",
      "item": [
        {
          "name": "Ringkasan",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/stats/summary"
          }
        },
        {
          "name": "Alat populer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/stats/populer?limit=5"
          }
        }
      ]
    }
  ]
}
