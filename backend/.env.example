# Salin file ini menjadi .env lalu sesuaikan nilainya.
PORT=5000
NODE_ENV=development

# Wajib diganti dengan string acak panjang saat deploy.
JWT_SECRET=sipinjam-rahasia-lokal-ganti-saat-deploy

# Database MySQL. Kosongkan DB_PASSWORD jika memakai XAMPP default.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sipinjam

# Aktifkan untuk database cloud yang mewajibkan TLS (Aiven, Railway, dll).
DB_SSL=false

# * membolehkan semua origin. Untuk produksi bisa diisi domain tertentu,
# misalnya https://sipinjam.example.com
CORS_ORIGIN=*

# Tarif denda per hari keterlambatan (rupiah).
DENDA_PER_HARI=2000
