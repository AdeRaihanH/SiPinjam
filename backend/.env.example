# Salin menjadi .env lalu isi DATABASE_URL dari dashboard Neon.
PORT=5000
NODE_ENV=development

# Neon: Connection string (pakai host -pooler).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Wajib diisi saat NODE_ENV=production.
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=7d

CORS_ORIGIN=*
DENDA_PER_HARI=2000