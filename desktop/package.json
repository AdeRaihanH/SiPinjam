{
  "name": "sipinjam-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "SiPinjam untuk Windows - aplikasi peminjaman alat laboratorium",
  "author": "Ade Raihan Hanafi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:web": "node scripts/copy-web.mjs",
    "build": "node scripts/copy-web.mjs && electron-builder --win portable"
  },
  "build": {
    "appId": "com.aderaihan.sipinjam",
    "productName": "SiPinjam",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "SiPinjam-${version}-Windows.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
